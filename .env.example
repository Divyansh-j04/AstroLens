# Copy this file to .env and fill in the real value. Never commit .env.
# Free key: https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=
# Language model used for the chat (list available ones in the Groq console)
GROQ_MODEL=openai/gpt-oss-20b

# Deployment (Phase 5). Hugging Face: Settings -> Access Tokens -> New token (type: Write)
HF_TOKEN=
# Vercel: Account Settings -> Tokens -> Create
VERCEL_TOKEN=
